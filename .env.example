# 后端服务
HOST=127.0.0.1
PORT=8000

# 本地数据目录。相对路径会基于仓库根目录解析。
DATA_DIR=./data

# SQLite 连接串。默认会落到 DATA_DIR 下。
DATABASE_URL=sqlite:///./data/app.db

# 可选：显式指定 ffmpeg 可执行文件路径。
# 不设置时，后端会通过系统 PATH 查找。
FFMPEG_PATH=

# 可选：前端访问后端的地址。Next.js 开发环境默认从 NEXT_PUBLIC_API_BASE_URL 读取。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# 可选：免费 faster-whisper 转写服务地址。
# 本地运行 whisper_backend 时使用 http://127.0.0.1:8001。
NEXT_PUBLIC_WHISPER_API_URL=http://127.0.0.1:8001

# 可选：转写服务如果设置了 WHISPER_API_KEY，这里填同一个值。
NEXT_PUBLIC_WHISPER_API_KEY=

# 可选：FunASR Paraformer 流式转写服务地址。
# 本地运行 funasr_backend 时使用 http://127.0.0.1:8002。
NEXT_PUBLIC_FUNASR_API_URL=http://127.0.0.1:8002

# 可选：LLM 大纲生成（思维导图）。支持任何 OpenAI 兼容接口，包括本地部署的模型。
# 留空则思维导图使用本地规则化大纲，不会调用任何模型，也不会伪造「AI 生成」结果。
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60
